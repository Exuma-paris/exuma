# Untitled UI Icons Pro — access token for the private npm registry.
# Required by .npmrc to install @untitledui-pro/icons.
# Get your token from https://www.untitledui.com (account settings).
#
# Set this in your shell BEFORE running `npm install`:
#   export UNTITLED_UI_TOKEN=your-token-here
# or paste into your shell profile (~/.zshrc, ~/.bashrc).
UNTITLED_UI_TOKEN=

# Google Gemini API key used by the image generation scripts.
# Optional for writers who only edit text.
GEMINI_API_KEY=
